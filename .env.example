# Enable this for any internet-facing deployment.
LLMSTORM_PUBLIC_MODE=1

# Public deployments should start conservatively.
LLMSTORM_MAX_CONCURRENCY=500
LLMSTORM_MAX_ACTIVE_TESTS=2

# Online pricing refresh; cached for six hours by default.
LLMSTORM_PRICING_CACHE_SECONDS=21600
LLMSTORM_PRICING_TIMEOUT_SECONDS=12

HOST=0.0.0.0
PORT=8765
